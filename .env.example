API_BASE_URL=/api/v1.0
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/solar-generation

# Set a random signing key of at least 32 bytes locally; never commit real keys.

JWT_SIGNING_KEY=
JWT_ISSUER=solar-generation-api
JWT_AUDIENCE=solar-generation-users
JWT_EXPIRES_IN_SECONDS=900

# Development only: installation password = this prefix + exact meterId.
# Production devices require independent credentials. Set the prefix locally.

DEVICE_HASH_COMMON_PREFIX=
