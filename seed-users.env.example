# Copy to seed-users.env and replace every example email and blank password.
# seed-users.env is ignored by Git. Never commit real credentials.
# Database configuration belongs in .env. Run npm run seed before npm run seed:users.
# Quote passwords containing # or surrounding spaces.
# MONARAGALA is the required credential key for the stored Moneragala district.

# Admin (1)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# National analyst (1)
SEED_NATIONAL_EMAIL=national@example.com
SEED_NATIONAL_PASSWORD=

# Provincial analysts (9)
